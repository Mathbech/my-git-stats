# Service systemd pour lancer my-git-stats sans Docker.
# Placement : /etc/systemd/system/my-git-stats.service
#
# Adapte : WorkingDirectory (chemin réel du projet), User, et le chemin de node
# (vérifie avec « which node » ; souvent /usr/bin/node).
#
# Activation :
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now my-git-stats
#   sudo systemctl status my-git-stats        # doit être "active (running)"
#   journalctl -u my-git-stats -f             # voir les logs

[Unit]
Description=my-git-stats - cartes de stats GitHub en SVG
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/my-git-stats
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
# Le .env est lu automatiquement par le code (src/loadenv.js).
# Il doit se trouver dans WorkingDirectory.
User=www-data
Group=www-data

[Install]
WantedBy=multi-user.target
