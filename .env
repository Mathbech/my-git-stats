# Fichier VERSIONNÉ (committé) — ne mets ici QUE des valeurs non-sensibles.
# Le vrai token va dans .env.local (ignoré par git). .env.local a la priorité.

# Token GitHub — LAISSE VIDE ici. Définis-le dans .env.local :
#   PAT_1=ghp_ton_token
PAT_1=

# Cache HTTP en secondes (0 = désactivé). 21600 = 6h.
CACHE_SECONDS=21600

# Usernames autorisés (virgules). Vide = tout le monde.
WHITELIST=
# Port interne (défaut 9000).
# PORT=9000
