# Copie ce fichier en `.env.local` puis mets ton vrai token.
# `.env.local` est ignoré par git — ne committe JAMAIS de secret.

# Personal Access Token GitHub (scope: public_repo / read:user).
PAT_1=ghp_xxxxxxxxxxxxxxxxxxxx

# Optionnel : plusieurs tokens pour la rotation (PAT_2, PAT_3, ...).
# PAT_2=

# Cache HTTP en secondes (0 = désactivé).
CACHE_SECONDS=21600

# Usernames autorisés (séparés par des virgules). Vide = tous autorisés.
WHITELIST=

# Port interne (défaut 9000).
# PORT=9000
